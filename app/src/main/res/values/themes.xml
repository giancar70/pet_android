<resources>
    <!-- The app is always light-themed (white screens, dark text/icons) and never follows
         the system's dark-mode setting. Without an explicit windowLightStatusBar/
         windowLightNavigationBar, the OS decides the status/navigation bar's icon color
         and (on some OEM skins) background on its own based on the *phone's* theme, which
         on some devices left a stray white status bar with white (invisible) icons when
         the phone was in dark mode. Forcing both here makes the bars render the same way
         (white background, dark icons) on every device regardless of system theme. -->
    <style name="Theme.PetProjectAPP" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- White background, matching every other screen in the app (see Theme.PetProjectAPP
         above), so the Android 12+ system splash (shown while the process is
         cold-starting, before MainActivity.onCreate runs) and everything after it read as
         one continuous screen instead of a visible green-to-white cut. -->
    <style name="Theme.PetProjectAPP.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PetProjectAPP</item>
    </style>
</resources>
